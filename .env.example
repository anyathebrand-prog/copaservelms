# Template only — copy to .env and fill that in instead.
#
# .env is gitignored; this file is committed. Never put a real key here: a
# secret in this file goes to the repository, and GitHub push protection is the
# last line of defence rather than the first.

# --- Database (Supabase Postgres) -----------------------------------------
# Pooled connection (PgBouncer, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma Migrate — migrations cannot run over PgBouncer.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Private Storage bucket holding certificate PDFs. Create it in Supabase Storage.
SUPABASE_CERTIFICATE_BUCKET="certificates"
# Private bucket holding assignment uploads.
SUPABASE_SUBMISSION_BUCKET="submissions"

# --- Communications (planned) ---------------------------------------------
RESEND_API_KEY=""
TERMII_API_KEY=""
# Sender identity for outbound messages. The Resend address must be on a
# domain you have verified; Termii sender IDs are approved per account.
NOTIFICATION_FROM_EMAIL="CopaServe <no-reply@copaserve.ng>"
TERMII_SENDER_ID="CopaServe"

# --- Payments (planned) ----------------------------------------------------
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
# Flutterwave signs webhooks with this configured value rather than an HMAC of
# the body. Set the same string here and in the Flutterwave dashboard.
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Public URLs -----------------------------------------------------------
# Where this deployment is reachable. Used for links that leave the app —
# email bodies and certificate QR codes — where a relative path is useless.
# Vercel supplies this automatically, so it is only needed for a custom domain.
NEXT_PUBLIC_APP_URL=""

# Where certificate QR codes point. Defaults to <app URL>/verify. Change this
# only BEFORE certificates are issued: the URL is baked into every PDF and QR
# code at issuance, so moving it later strands codes already in circulation.
NEXT_PUBLIC_VERIFICATION_BASE_URL=""

# --- Scheduled jobs --------------------------------------------------------
# Authorises /api/cron/webhooks. Vercel sends it as a Bearer token on cron
# invocations; without it the route refuses to run rather than sitting open.
CRON_SECRET=""

# Supabase Send SMS hook. Supabase generates sign-in codes and posts them to
# /api/auth/sms-hook for Termii to deliver; this secret is what proves the
# request came from Supabase. Without it the endpoint refuses every request,
# which is correct — it would otherwise text a valid login code to any number
# an attacker asked for.
SUPABASE_SMS_HOOK_SECRET=

# Drafting quiz questions from lesson text (PRD 5.2). Absent, the drafting
# button is hidden and authoring by hand is unaffected -- the same shape as the
# email and SMS drivers. Nothing drafted is ever saved without an instructor
# reviewing and saving it.
ANTHROPIC_API_KEY=
