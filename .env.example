# --- Database (Supabase Postgres) -----------------------------------------
# Pooled connection (PgBouncer, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma Migrate — migrations cannot run over PgBouncer.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Private Storage bucket holding certificate PDFs. Create it in Supabase Storage.
SUPABASE_CERTIFICATE_BUCKET="certificates"
# Private bucket holding assignment uploads.
SUPABASE_SUBMISSION_BUCKET="submissions"

# --- Communications (planned) ---------------------------------------------
RESEND_API_KEY=""
TERMII_API_KEY=""

# --- Payments (planned) ----------------------------------------------------
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
# Flutterwave signs webhooks with this configured value rather than an HMAC of
# the body. Set the same string here and in the Flutterwave dashboard.
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Certificate verification ---------------------------------------------
NEXT_PUBLIC_VERIFICATION_BASE_URL="https://verify.bitlearn.ng"
